# Only used by scripts/seed-jira.js. Copy to .env (git-ignored); never commit real values.
# The workflow itself reads secrets from n8n credentials, not from this file.
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
# optional: comma-separated Jira accountIds to spread sample assignments over
JIRA_ASSIGNEES=
